# Supabase — projeto na conta SOMA
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca exposta ao client — usada só em rotas server-side (ex: webhook
# do Mercado Pago) que precisam ignorar RLS.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, usada para montar o link de aceite enviado ao
# comprador. Em produção na Vercel isso é preenchido automaticamente
# por NEXT_PUBLIC_VERCEL_URL — só defina esta se quiser um domínio
# customizado (ex: app.somaimobiliaria.com.br).
NEXT_PUBLIC_SITE_URL=

# Mercado Pago — credenciais da conta SOMA (Pix com QR Code e cartão
# em até 12x). O access token fica só no server; a public key é usada
# no client para montar o Payment Brick/Checkout.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Segredo enviado pelo Mercado Pago para validar a assinatura das
# notificações de webhook (x-signature). Configurado no painel de
# Webhooks do Mercado Pago ao cadastrar a URL de notificação.
MERCADOPAGO_WEBHOOK_SECRET=
